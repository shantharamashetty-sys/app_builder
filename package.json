{
  "name": "app-builder-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:builder": "npm run dev -w apps/builder",
    "dev:api": "npm run start:dev -w apps/api",
    "build:builder": "npm run build -w apps/builder",
    "build:api": "npm run build -w apps/api",
    "build": "npm run build:builder && npm run build:api",
    "lint:builder": "npm run lint -w apps/builder",
    "lint": "npm run lint:builder"
  }
}
